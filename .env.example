# Runtime connection used by NestJS. Prefer the Supabase session pooler for a
# long-running API process.
DATABASE_URL=postgresql://APP_USER:PASSWORD@POOLER_HOST:5432/DATABASE

# Direct/session connection used only by Prisma migration commands.
DIRECT_URL=postgresql://MIGRATION_USER:PASSWORD@DIRECT_OR_SESSION_HOST:5432/DATABASE

# Separate disposable development database used by `prisma migrate dev`.
# Never point this at the main development, shared, staging, or production DB.
SHADOW_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@SHADOW_HOST:5432/SHADOW_DATABASE

JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000
PORT=3001

# Payment provider variables are intentionally omitted from this hardening pass.
