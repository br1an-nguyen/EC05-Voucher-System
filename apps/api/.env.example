# Database Configuration (Railway Postgres / Supabase / Postgres)
# DATABASE_URL is used by the running API and is also the migration fallback.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Optional when DATABASE_URL is already a direct connection. Set DIRECT_URL when
# DATABASE_URL goes through a pooler and migrations need the direct Postgres port.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# JWT Authentication (Bắt buộc, tối thiểu 32 ký tự)
JWT_SECRET="your_jwt_secret_key_at_least_32_characters_long"

# App & Client Configuration
APP_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"
TRUST_PROXY=""

# Refresh-token cookie. Production deployments on separate frontend/API domains
# require HTTPS, Secure=true and SameSite=none.
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAME_SITE="lax"

# Payments Configuration
# SIMULATED never calls Stripe. SANDBOX calls Stripe test APIs only.
PAYMENT_MODE="SIMULATED"

# Required only when PAYMENT_MODE="SANDBOX". Never use sk_live_ keys here.
# STRIPE_SECRET_KEY="sk_test_..."
# From Stripe CLI (`stripe listen`) or a Stripe Dashboard test-mode endpoint.
# STRIPE_WEBHOOK_SECRET="whsec_..."
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_API_URL="https://api-m.sandbox.paypal.com"
# VNPAY Sandbox. Required when the customer selects VNPAY.
VNP_TMN_CODE=""
VNP_HASH_SECRET=""
VNP_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_RETURN_URL="http://localhost:3000/payments/return/vnpay"
VNP_IPN_URL="https://your-public-api.example.com/payments/vnpay/ipn"
VNP_VERSION="2.1.0"
